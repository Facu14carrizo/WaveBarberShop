# Netlify Headers Configuration
# Prevenir que los navegadores guarden index.html en caché
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# Permitir caché larga para assets con hash inmutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
